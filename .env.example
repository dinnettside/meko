# Copy this file to .env.local and fill in the values.
# .env.local is gitignored. Never commit real keys.

# Nebius Token Factory
NEBIUS_API_KEY=
NEBIUS_MODEL=

# Tavily web search
TAVILY_API_KEY=

# ElevenLabs text-to-speech
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Needed on Vercel: making a video asks for this code, so strangers cannot spend the API credits. Without it, the
# deployed app makes no new videos. Use a long random code. Leave it empty locally.
DEMO_CODE=

# Vercel Blob: the library of finished videos and drawings. On Vercel, connecting a Blob store to the project is
# enough. Locally, paste the store's read-write token here. Without it, every video is made fresh and nothing is kept.
BLOB_READ_WRITE_TOKEN=
