# Copy this file to .env.local and fill in the values.
# .env.local is gitignored. Never commit real keys.

# Nebius Token Factory
NEBIUS_API_KEY=
NEBIUS_MODEL=

# Tavily web search
TAVILY_API_KEY=

# ElevenLabs text-to-speech
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Only for the hosted demo: making a video then needs this code, so strangers cannot spend the API credits.
# Leave it empty locally.
DEMO_CODE=
